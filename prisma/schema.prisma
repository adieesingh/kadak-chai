generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Entry {
  id     String  @id @default(uuid())
  slug    String  @unique

  // User form data
  name String
  city  String
  contact String
  contactType String
  story   String
  consent  Boolean

  // Moderation status ("pending_review" | "approved" | "rejected")
  status  String  @default("pending_review")

  // AI ka output
  aiDecision  String?
  aiReason  String?
  aiCategory   String?
  aiRaw    String?
  aiError String?
  aiProvider  String?
  aiCaption    String?

  // Admin manual override data
  overriddenBy  String?
  overriddenAt  DateTime?
  adminNote     String?

  // Spam aur abuse rokne ke liye hashed IP
  ipHash        String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  entryEvent    EntryEvent[]

  @@index([status, createdAt])
  @@index([aiCategory])
  @@unique([contact])    
}

model EntryEvent {
  id        String   @id @default(cuid())
  entryId   String
  entry     Entry    @relation(fields: [entryId], references: [id])
  type      String   // "submitted" | "ai_decided" | "ai_failed" | "admin_override"
  fromStatus String?
  toStatus   String?
  meta      String?  
  createdAt DateTime @default(now())

  @@index([entryId, createdAt])
}