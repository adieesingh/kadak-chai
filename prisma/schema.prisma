// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Entry {
  id     String  @id @default(uuid())
  slug    String  @unique

// user form 
  name String
  city  String
  contact String
  contactType String
  story   String
  consent  Boolean


  //status
  status  String  @default("pending_review")

  // Ai ka output
  aiDecision  String?
  aiReason  String?
  aiCategory   String?
  aiRaw    String?
  aiError String?
  aiProvider  String?
  aiCaption    String?

  // Admin override
  overriddenBy  String?
  overriddenAt  DateTime?
  adminNote     String?

  // Abuse protection 
  ipHash        String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  entryEvent    EntryEvent[]

  @@index([status, createdAt])
  @@index([aiCategory])
  @@unique([contact])    
}

model EntryEvent {
  id        String   @id @default(cuid())
  entryId   String
  entry     Entry    @relation(fields: [entryId], references: [id])
  type      String   // "submitted" | "ai_decided" | "ai_failed" | "admin_override"
  fromStatus String?
  toStatus   String?
  meta      String?  
  createdAt DateTime @default(now())

  @@index([entryId, createdAt])
}