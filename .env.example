# Copy to .env and fill in. NEVER commit .env or real keys.

# Database (SQLite for local; swap for a Postgres URL when deploying)
DATABASE_URL="file:./dev.db"

# AI provider. "mock" works with no API key (default for reviewers).
AI_PROVIDER=mock
# Only needed when AI_PROVIDER is not "mock". Any OpenAI-compatible endpoint:
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1   (AI_API_KEY can stay empty)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Milliseconds before an AI call is treated as a timeout
AI_TIMEOUT_MS=8000

# Admin dashboard login (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 16+ random characters, e.g. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
