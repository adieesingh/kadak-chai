# Copy to .env:  cp .env.example .env
# Defaults work locally with AI_PROVIDER=mock (no API key needed).

# PostgreSQL. This URL matches `docker compose up db -d`
DATABASE_URL="postgresql://kadak:kadakpass@localhost:5432/kadakchai?schema=public"

# AI: "mock" = fake predictable output. Anything else = real OpenAI-compatible provider
AI_PROVIDER=mock
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_MS=8000

# Admin login. In production the password must be 12+ characters and not "change-me"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Optional: Upstash Redis for shared rate limiting.
# If omitted, an in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
